---
import About from "../components/About.astro";
import LibrarySlide from "../components/LibrarySlide.astro";
import ProjectSlide from "../components/ProjectSlide.astro";
import Traveler from "../components/Traveler.astro";
import { projects, libraries } from "../data/portfolio";
import favicon from "../assets/sya-ri.svg?url";
import "../styles/portfolio.css";
import "../styles/runner.css";

const title = "sya_ri — Minecraft Plugin Developer / Fullstack Engineer";
const description =
  "A look at what I build for Minecraft players and plugin developers, plus a microphone mixer and a few projects that reach beyond the game.";
const canonical = new URL("/", Astro.site);
const sharingImage = new URL("/images/portfolio.png", canonical);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={favicon} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={sharingImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="sya-ri’s mint portrait beside the portfolio name and job title."
    />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <div id="portfolio">
      <header class="signature">
        <a href="#about" aria-label="sya_ri — About">
          sya_ri
        </a>
        <nav aria-label="Main" class="section-nav">
          <a data-section="about" href="#about" aria-current="location">
            About
          </a>
          <a data-section="projects" href={`#${projects[0].slug}`}>
            Projects
          </a>
          <a data-section="libraries" href={`#${libraries[0].slug}`}>
            Libraries
          </a>
        </nav>
      </header>
      <main class="reader" aria-label="Portfolio" tabindex="0">
        <div class="work-grid">
          <About />
          {projects.map((project) => (
            <ProjectSlide project={project} />
          ))}
          {libraries.map((library) => (
            <LibrarySlide library={library} />
          ))}
        </div>
        <Traveler />
      </main>
    </div>
    <script>
      import "../scripts/gallery";
    </script>
  </body>
</html>
