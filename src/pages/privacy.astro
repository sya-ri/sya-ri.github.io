---
import favicon from "../assets/sya-ri.svg?url";
import "../styles/portfolio.css";

const title = "Privacy policy — sya_ri";
const description =
  "How s7a.dev handles site visits, your color preference, and advertising cookies.";
const canonical = new URL("/privacy", Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={favicon} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
  </head>
  <body>
    <main class="policy">
      <a href="/#about">Back to About</a>
      <h1>Privacy policy</h1>
      <p class="updated">
        Last updated <time datetime="2026-11-25">November 25, 2026</time>
      </p>
      <p>I’m sya-ri. This policy covers my portfolio at s7a.dev.</p>

      <h2>When you visit</h2>
      <p>
        Vercel hosts this site. When you open a page or load an image, Vercel receives your IP
        address and the URL you requested so it can deliver the file and keep the site secure. See{" "}
        <a href="https://vercel.com/legal/privacy-notice" target="_blank" rel="noopener noreferrer">
          Vercel’s privacy notice
        </a>
        for details.
      </p>

      <h2>Your color preference</h2>
      <p>
        When you change the character’s color, the site saves your choice in your browser’s local
        storage so you see the same color on your next visit. You can reset it by clearing the site
        data for s7a.dev in your browser.
      </p>

      <h2>Advertising and your choices</h2>
      <p>
        If this site shows Google AdSense ads, your browser sends Google your IP address and the URL
        of the page you’re viewing. Google and its advertising partners may use cookies to deliver
        and measure ads. Depending on your settings, they may also personalize ads based on your
        visits to this and other websites.
      </p>
      <p>
        You can turn off personalized ads in{" "}
        <a href="https://myadcenter.google.com/" target="_blank" rel="noopener noreferrer">
          Google’s My Ad Center
        </a>
        . For choices from other participating ad companies, visit{" "}
        <a href="https://youradchoices.com/control" target="_blank" rel="noopener noreferrer">
          YourAdChoices
        </a>
        . Google also explains{" "}
        <a
          href="https://policies.google.com/technologies/partner-sites"
          target="_blank"
          rel="noopener noreferrer"
        >
          how it uses data from partner sites
        </a>
        and lists its{" "}
        <a
          href="https://support.google.com/adsense/answer/94149?hl=en"
          target="_blank"
          rel="noopener noreferrer"
        >
          certified ad vendors
        </a>
        .
      </p>

      <h2>Contact</h2>
      <p>
        For privacy questions about this site, you can reach me on X at
        <a href="https://x.com/sya_ri_dayo" target="_blank" rel="noopener noreferrer">
          @sya_ri_dayo
        </a>
        .
      </p>
    </main>
  </body>
</html>

<style>
  .policy {
    max-width: 70ch;
    margin-inline: auto;
    padding: clamp(1.25rem, 5vw, 3rem) 1.25rem 4rem;
    line-height: 1.6;
  }
  h1 {
    margin-block: 1.5rem 0;
    font-size: clamp(2.25rem, 7vw, 3.5rem);
    letter-spacing: -0.045em;
    line-height: 1.1;
  }
  h2 {
    margin-block: 2rem 0.35rem;
    font-size: 1.3rem;
    line-height: 1.3;
  }
  p + p {
    margin-block-start: 0.8rem;
  }
  .updated {
    margin-block-start: 0.5rem;
    color: var(--muted);
    font-size: 0.9rem;
  }
  a {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }
</style>
