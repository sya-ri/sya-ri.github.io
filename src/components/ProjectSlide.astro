---
import WorkHeading from "./WorkHeading.astro";
import type { Project } from "../data/portfolio";
import { highlight } from "../lib/highlight";
interface Props {
  project: Project;
}
const { project } = Astro.props;
---

<article
  class="work project"
  id={project.slug}
  data-section="projects"
  aria-labelledby={`heading-${project.slug}`}
>
  <WorkHeading work={project} />
  <p class="project-description">{project.description}</p>
  {"image" in project ? (
    <img
      class:list={["project-preview", { recipe: project.slug === "minecraft-inventory" }]}
      {...project.image}
    />
  ) : (
    <div
      class="code-pane project-code"
      data-scroll-panel
      role="region"
      tabindex="0"
      aria-label={`${project.name} command example`}
      set:html={await highlight(project.example)}
    />
  )}
</article>
